)
C++ AI Server — server.cpp
class TextServiceImpl : public text_pb2_grpc::TextService::Service {

    grpc::Status Inference(
        grpc::ServerContext* context,
        const text_pb2::TextRequest* request,
        text_pb2::TextResponse* response) override
    {
        std::string text = request->text();

        // Ví dụ: phân loại cảm xúc đơn giản
        std::string label = "positive";
        float confidence = 0.95;

        response->set_label(label);
        response->set_confidence(confidence);

        return grpc::Status::OK;
    }
};
